# ============================================================
# Lutra Legacy i686 配置碎片
# 目标：2012 年前后的 32 位 PC；不包含 AI 运行时
# 交叉编译：i686-linux-gnu- 或本机 gcc -m32
# ============================================================

CONFIG_64BIT=n
CONFIG_X86_32=y
CONFIG_X86=y
CONFIG_M686=y
CONFIG_HIGHMEM4G=y
CONFIG_X86_UP_APIC=n
CONFIG_X86_MCE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
CONFIG_MICROCODE_AMD=y

# ---------- 老硬件显示 ----------
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VIA=m
CONFIG_DRM_SIS=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VGA_CONSOLE=y

# ---------- 存储（IDE 时代） ----------
CONFIG_ATA=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_PATA_AMD=y
CONFIG_PATA_JMICRON=y
CONFIG_PATA_SIS=y
CONFIG_PATA_VIA=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y

# ---------- 网络 ----------
CONFIG_E100=m
CONFIG_E1000=m
CONFIG_R8169=m
CONFIG_8139TOO=m
CONFIG_8139CP=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH5K=m
CONFIG_ATH9K=m
CONFIG_RTL8187=m
CONFIG_B43=m
CONFIG_B43LEGACY=m

# ---------- 音频 ----------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_INTEL8X0=m
CONFIG_SND_VIA82XX=m
CONFIG_SND_ENS1370=m
CONFIG_SND_AC97_CODEC=m

# ---------- 输入 ----------
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y

CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y

#!/bin/sh
# Lutra 会话启动脚本 —— labwc 就绪后执行。

# 输入法：中文默认（fcitx5 + rime）
fcitx5 -d --replace 2>/dev/null || true

# 通知守护：权限确认等交互由 mako 承载按钮
mako 2>/dev/null &

# 音频：优先交给 systemd 用户服务；容器/无 systemd 环境下回退为直接拉起
if ! systemctl --user start pipewire.service pipewire-pulse.service wireplumber.service 2>/dev/null; then
    pipewire 2>/dev/null &
    pipewire-pulse 2>/dev/null &
    wireplumber 2>/dev/null &
fi

# 壁纸：先用纯深色，后续版本替换为 lutra-default.png
if command -v swaybg >/dev/null 2>&1; then
    if [ -f /usr/share/lutra/wallpaper/lutra-default.png ]; then
        swaybg -m fill -i /usr/share/lutra/wallpaper/lutra-default.png &
    else
        swaybg -c '#1a1a1a' &
    fi
fi

# 顶栏：优先自研 lutra-shell；启动失败时回退 waybar
if command -v lutra-shell >/dev/null 2>&1; then
    lutra-shell &
    sleep 2
    if ! pgrep -x lutra-shell >/dev/null 2>&1; then
        command -v waybar >/dev/null 2>&1 && waybar &
    fi
elif command -v waybar >/dev/null 2>&1; then
    waybar &
fi

# 统一使用 LF，避免 Linux 侧脚本出现 CRLF 导致 bad interpreter
* text=auto eol=lf

*.sh          text eol=lf
*.cfg         text eol=lf
*.py          text eol=lf
*.rs          text eol=lf
*.toml        text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.conf        text eol=lf
*.desktop     text eol=lf
*.xml         text eol=lf
*.md          text eol=lf
*.svg         text eol=lf

# Windows 侧脚本保持 CRLF
*.ps1         text eol=crlf
*.cmd         text eol=crlf
*.bat         text eol=crlf

# 二进制
*.exe         binary
*.iso         binary
*.img         binary
*.qcow2       binary
*.vhdx        binary
*.tar         binary
*.tar.*       binary
*.lup         binary
*.ltr         binary
*.png         binary
*.jpg         binary
*.zst         binary
